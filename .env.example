# Copy to backend/.env and fill in. Never commit the real file.
AWS_REGION=us-east-1
AWS_PROFILE=floodsense
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL_ID=amazon.nova-pro-v1:0
DDB_TABLE_SEGMENTS=floodsense-segments
DDB_TABLE_DRAINS=floodsense-drains
DDB_TABLE_REPORTS=floodsense-reports
DDB_TABLE_ALERTS=floodsense-alerts
S3_BUCKET_UPLOADS=floodsense-uploads-CHANGE-ME
SNS_DEMO_PHONE=+91XXXXXXXXXX

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_LOCATION_API_KEY=
NEXT_PUBLIC_LOCATION_REGION=us-east-1
