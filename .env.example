# Backend: copy to backend/.env (git-ignored). Every value is optional; with none set the
# backend runs fully offline on a local JSON file.
AWS_REGION=us-east-1
FLOODSENSE_USE_BEDROCK=1                       # Nova photo checks (vision.py)
BEDROCK_VISION_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_AGENT_MODEL_ID=amazon.nova-pro-v1:0    # Strands agent (agent.py)
FLOODSENSE_USE_SNS=0                           # 1 = send real SMS through Amazon SNS
SNS_DEMO_PHONE=+91XXXXXXXXXX                   # number verified in the SNS SMS sandbox
FLOODSENSE_METRICS=0                           # 1 = publish CloudWatch metrics (namespace FloodSense)

# Set on Lambda only: store state in DynamoDB and photos in S3 instead of local files.
# FLOODSENSE_TABLE=floodsense
# FLOODSENSE_BUCKET=floodsense-photos-<account-id>
# FLOODSENSE_STATE_DIR=/tmp/state

# Frontend: frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_MAP_STYLE=<MapLibre style URL>   # defaults to OpenFreeMap positron
